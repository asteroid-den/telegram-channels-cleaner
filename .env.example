# All settings are optional. Copy to `.env` and uncomment what you need.

# Telegram API credentials. Defaults to the public Telegram Desktop pair.
# Get your own at https://my.telegram.org/apps
# CC_API_ID=2040
# CC_API_HASH=b18441a1ff607e10a989891a5462e627

# Where sessions, the SQLite DB and the media cache live. Default: ./data in a source
# checkout, otherwise ~/.local/share/telegram-channels-cleaner (macOS: ~/Library/Application Support,
# Windows: %APPDATA%). In Docker it is the /data volume.
# CC_DATA_DIR=./data

# HTTP server
# CC_HOST=127.0.0.1
# CC_PORT=8765

# The page the phone pairing QR goes through (cameras open links with a domain, not a bare IP).
# It only forwards the phone to this computer's address, which stays after `#`. Empty = the QR holds that address.
# CC_PAIRING_PAGE=https://asteroid-den.github.io/telegram-channels-cleaner/pair/


# Use a fake Telegram backend with generated channels (no account needed).
# CC_MOCK=1
